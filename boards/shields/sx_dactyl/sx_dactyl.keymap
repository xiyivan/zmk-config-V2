#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Define Layer Indexes
#define DEFAULT 0
#define LOWER   1
#define NUMPAD  2

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
// ---------------------------------------------------------------------------------------------------------------------------------
// | ESC  |  `   |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  -  |  =  |
// | TAB  | TRANS|  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |
// | CAPS | TRANS|  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '  | ENT |
// | SHFT | MO(1)|  Z  |  X  |  C  |  V  |         |  B  |  N  |  M  |  ,  |  .  |  /  |  \  |
//               |     |     |                                 |     |     |
//                           |     |MO(2)|         | B   |     |
//                                 |alt  |space|   |space|alt  |
//                                 |ctrl |shift|   |shift|ctrl |

    &kp ESC    &kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5       &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL
    &kp TAB    &trans     &kp Q     &kp W     &kp E     &kp R     &kp T        &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT
    &kp CAPS   &trans     &kp A     &kp S     &kp D     &kp F     &kp G        &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &kp RET
    &kp LSHFT  &mo LOWER  &kp Z     &kp X     &kp C     &kp V                 &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp BSLH
                          &none     &none                                       &none     &none
                                              &none     &mo NUMPAD             &kp B     &none
                                                        &kp LALT  &kp SPACE   &kp SPACE &kp RALT
                                                        &kp LCTRL &kp LSHFT   &kp RSHFT &kp RCTRL
            >;
        };

        lower_layer {
            bindings = <
// ---------------------------------------------------------------------------------------------------------------------------------
// On this layer, most keys are 'trans' (inherit from Layer 0), except the Studio Unlock key
    &trans     &trans     &trans    &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans    &trans    &trans
    &trans     &trans     &trans    &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans    &trans    &trans
    &trans     &trans     &trans    &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans    &trans    &trans
    &trans     &trans     &trans    &trans    &trans    &trans                           &trans    &trans    &trans    &trans    &trans    &trans    &trans
                          &none     &none                                                &none     &none
                                              &none     &none                  &none     &none
                                                        &none     &none        &none     &studio_unlock
                                                        &none     &none        &none     &none
            >;
        };

        numpad_layer {
            bindings = <
// ---------------------------------------------------------------------------------------------------------------------------------
// | ESC  |  `   | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 | F11 | F12 |
// | TAB  | TRANS|  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |     | KP7 | KP8 | KP9 |
// | CAPS | TRANS|  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |     | KP4 | KP5 | KP6 |
// | SHFT | MO(1)|  Z  |  X  |  C  |  V  |         |  B  |  N  |  M  |     | KP1 | KP2 | KP3 |
//               |     |     |                                 |     | KP0 |
//                           |     |MO(2)|         | KP0|     |
//                                 |alt  |space|   |KP. |ENTR |
//                                 |ctrl |shift|   |shift|ctrl |

    &kp ESC    &kp GRAVE  &kp F1    &kp F2    &kp F3    &kp F4    &kp F5       &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
    &trans     &trans     &trans    &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &kp KP_N7 &kp KP_N8 &kp KP_N9 
    &trans     &trans     &trans    &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &kp KP_N4 &kp KP_N5 &kp KP_N6 
    &trans     &trans     &trans    &trans    &trans    &trans                 &trans    &trans    &trans    &trans    &kp KP_N1 &kp KP_N2 &kp KP_N3
                          &none     &none                                                &none     &kp KP_N0
                                              &none     &mo NUMPAD             &kp KP_N0 &none
                                                        &trans    &trans      &kp KP_DOT &kp KP_ENTER
                                                        &trans    &trans      &trans     &trans
            >;
        };
    };
};